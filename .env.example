# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# At least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional
# Public URL of the admin panel, used only when DATA_DIR has no config.json yet
PANEL_URL=https://panel.example.com
# Discord user IDs with access to every server, comma-separated
SUPERADMIN_IDS=
ADMIN_PORT=3001
# Defaults to ./data locally and /app/data in the container
DATA_DIR=
